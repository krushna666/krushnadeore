# Database (Supabase PostgreSQL connection string)
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Storage (create a public bucket named `media`)
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-domain.com"

# First-run admin account (used only by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@olyxmedia.com"
SEED_ADMIN_PASSWORD="change-me-immediately"
SEED_ADMIN_NAME="OlyxMedia Admin"

# Outbound email — Hostinger mailbox for support@olyxmedia.com
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="support@olyxmedia.com"
SMTP_PASSWORD="your-hostinger-mailbox-password"
SMTP_FROM="OlyxMedia <support@olyxmedia.com>"
LEAD_NOTIFICATION_EMAIL="support@olyxmedia.com"

# Public site URL (used for canonical/OG/sitemap generation)
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Cron secret for the scheduled-post publisher endpoint
CRON_SECRET="generate-a-random-secret"

# Optional: gates the AI content-helper fields in the blog admin. Leave unset to disable.
ANTHROPIC_API_KEY=""

# Optional: analytics/consent-gated scripts can also be set from /admin/settings instead of here.
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_CLARITY_ID=""
